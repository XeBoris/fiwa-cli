/* ============================================
   WEEK/MONTH PICKER WIDGET STYLING
   File: css/handsome/components_week_month_picker.tcss
   ============================================ */

/* === Main Widget Container === */
WeekMonthWidget {

}

/* === Vertical Container === */
WeekMonthWidget .week-month-picker-container {
    width: 22;
    height: 9;
    padding: 0 0 0 0;
    margin: 0 0 0 0;

    border: none $border;
    /*background: $surface;*/
    background: transparent;
    align: left top;
}

/* === Period Select Dropdown (Above Grid) === */
WeekMonthWidget #wm-period-select {
    margin: 0 0 0 0;
    width: 95%;
    height: 3;
    min-height: 3;
    align: left middle;
    content-align: left middle;
}

/* Dropdown overlay that appears when Select opens */
#wm-period-select SelectOverlay {
    max-height: 5;
}

/* Option list inside the dropdown */
#wm-period-select OptionList {
    max-height: 5;
    height: auto;
}

/* === Grid Layout === */
WeekMonthWidget #week-month-picker-grid {
    grid-size: 2 2;         /* 2 columns, 2 rows */
    grid-gutter: 1 1;       /* No gaps between cells */
    width: 100%;
    height: auto;
    min-height: 6;
    max-width: 20;
    align: center middle;
}

/* === Navigation Buttons (Top Row: ◀ ▶) === */
WeekMonthWidget .wm-nav-button {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 3;
    content-align: center middle;
    text-align: center;
    border: none;
    background: $accent;
    color: $text;
    padding: 0;
    margin: 0;
}

WeekMonthWidget .wm-nav-button:hover {
    background: $accent-lighten-1;
    text-style: bold;
}

WeekMonthWidget .wm-nav-button:focus {
    background: $primary;
    text-style: bold;
}

/* === Display Labels (Bottom Row: Year | Week/Month) === */
WeekMonthWidget .wm-display {
    width: 100%;
    height: 3;
    min-height: 2;
    max-height: 4;
    align: center middle;
    content-align: center middle;
    text-align: center;
    background: $panel;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

/* Year Display - Left Bottom */
WeekMonthWidget #wm-period-year {
    text-style: bold;
    color: $text;
}

/* Week/Month Display - Right Bottom */
WeekMonthWidget #wm-period-value {
    text-style: bold;
    color: $accent;
}

/* === Compact Variant (Optional) === */
WeekMonthWidget.compact #week-month-picker-grid {
    min-height: 4;
    max-width: 18;
}

WeekMonthWidget.compact .wm-nav-button {
    height: 1;
    max-height: 1;
}

WeekMonthWidget.compact .wm-display {
    height: 1;
    min-height: 1;
    max-height: 2;
}

/* === Disabled State === */
WeekMonthWidget:disabled .wm-nav-button {
    opacity: 50%;
    background: $surface-darken-1;
}

WeekMonthWidget:disabled .wm-display {
    opacity: 70%;
    color: $text-muted;
}
