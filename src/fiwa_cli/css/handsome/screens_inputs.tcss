InputsScreen {

}

SettingsScreen #settings-title {
    text-style: bold;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    text-align: center;
}

InputsScreen #container-body {
    layout: horizontal;
    height: 1fr;
}

InputsScreen #container-sidebar {
    width: 27;
    height: 100%;
    background: $panel;
    border-right: solid $accent;
    padding: 1;
    scrollbar-size: 4 1;
}

InputsScreen .menu-section {
    text-style: bold;
    padding: 1 0 1 0;
    color: $accent;
}

InputsScreen .sidebar-menu-button {
    width: 90%;
    min-width: 20;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 0 0 0;
    border: none;
    content-align: center middle;
}

/*
SettingsScreen #container-sidebar > ScrollableContainer > Button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
}*/

InputsScreen #back-button {
    margin-top: 1;
    width: 100%;
}

# This element controls the right content area where forms and messages are displayed
# In particular the size and the scrollbar!!!
InputsScreen #inputs-content-area {
    width: 1fr;
    height: 100%;
    padding: 0;
    scrollbar-size: 3 1;
}

/* ===================================
   WeekMonthPicker in sidebar
   Override sizing to be compact
   =================================== */
InputsScreen #reports-date-picker {
    width: 100%;
    height: 8;
    margin: 1 0 1 0;
}
/* Override container to be more compact */
InputsScreen #reports-date-picker .week-month-picker-container {
    width: 100%;
    height: auto;
    max-height: 9;
    min-height: 8;
    padding: 0;
    margin: 0;
}
/* Compact the period select dropdown */
InputsScreen #reports-date-picker #wm-period-select {
    width: 100%;
    height: 3;
    max-height: 3;
    min-height: 3;
    margin: 0;
}
/* Ensure grid displays properly with navigation buttons visible */
InputsScreen #reports-date-picker #week-month-picker-grid {
    grid-size: 2 2;         /* 2 columns, 2 rows */
    grid-gutter: 1 1;       /* No gaps between cells */
    width: 100%;
    height: auto;
    min-height: 6;
    max-width: 20;
    align: center middle;
}
/* Compact navigation buttons (◀ ▶) - IMPORTANT for visibility */
InputsScreen #reports-date-picker .wm-nav-button {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 3;
    content-align: center middle;
    text-align: center;
    border: none;
    background: $accent;
    color: $text;
    padding: 0;
    margin: 0;
}
/* Compact display labels (Year and Week/Month) */
InputsScreen #reports-date-picker .wm-display {
    width: 100%;
    height: 3;
    min-height: 2;
    max-height: 4;
    align: center middle;
    content-align: center middle;
    text-align: center;
    background: $panel;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}
/* Constrain dropdown overlay to not overflow sidebar */
InputsScreen #reports-date-picker #wm-period-select SelectOverlay {
    max-height: 4;
}
InputsScreen #reports-date-picker #wm-period-select OptionList {
    max-height: 4;
    height: auto;
}



