    background: $success 70%;
    border: solid $success;
}

.tracker-day-level-3:hover {
    background: $success 90%;
    border: solid $success;
}

.tracker-day-level-4:hover {
    background: $success-lighten-1;
    border: solid $success-lighten-2;
}
*/

/* Legend at bottom */
.tracker-legend {
    width: 100%;
    height: 2;
    align: left middle;
    margin-top: 1;
}

.tracker-legend-label {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.tracker-legend-box {
    width: 3;
    height: 1;
    margin: 0 0;
    border: none;
}

