CreateUserForm {
    layout: vertical;
    width: 100%;
    height: 100%;
}

CreateUserForm .form-title {
    text-style: bold underline;
    text-align: center;
    padding: 0 0 0 0;
    margin: 1 1 1 1;
    background: $background;
/*    border: solid $accent;*/
    color: $text;
}

CreateUserForm .form-label {
    padding: 1 0 1 0;
    text-style: bold;
}

CreateUserForm .current-project-header {
    background: $primary 40%;
    color: $text;
    padding: 0 1 0 1;
    margin: 0 4 0 4;
    border: round $accent;
}

CreateUserForm #form-content {
    height: 1fr;
    width: 100%;
    margin: 1 0 0 3;
    padding: 0 0 0 0;
    overflow-y: auto;
    scrollbar-size: 3 1;
}



CreateUserForm Static {
    margin: 1 0;
}

CreateUserForm Input {
    width: 100%;
    margin: 0 0 1 0;
}

CreateUserForm Horizontal {
    height: auto;
    margin-top: 1;
}

CreateUserForm Horizontal Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
}