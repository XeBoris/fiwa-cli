/* ============================================
   REPLICATE EXPENSES VIEW STYLING
   File: css/handsome/screens_inputs_repl_expenses.tcss
   Component: ReplicateExpensesView
   ============================================ */

ReplicateExpensesView {
    height: 1fr;
}

ReplicateExpensesView .replicate-title {
    text-style: bold;
    padding: 0 0 1 0;
    margin: 0 0 1 0;
    text-align: center;
    color: $accent;
}

ReplicateExpensesView .date-info {
    text-align: center;
    padding: 1;
    margin: 0 0 1 0;
    background: $primary 30%;
    color: $text;
    border: solid $primary;
    text-style: bold;
}

ReplicateExpensesView .warning-message {
    text-align: center;
    padding: 2;
    margin: 2;
    background: $warning 30%;
    color: $text;
    border: solid $warning;
    text-style: bold;
}

ReplicateExpensesView #replicate-content {
    height: 1fr;
}

ReplicateExpensesView TabbedContent {
    height: auto;
    margin: 1 0;
}

ReplicateExpensesView TabPane {
    padding: 1;
}

ReplicateExpensesView DataTable {
    height: auto;
    min-height: 10;
    max-height: 30;
    border: solid $accent;
    margin: 0 0 1 0;
}

/* Style for updated (new month) rows */
ReplicateExpensesView DataTable > .datatable--cursor {
    background: $primary 20%;
}

/* Action buttons below each table */
ReplicateExpensesView .action-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1 0 2 0;
}

ReplicateExpensesView .action-buttons Button {
    width: 25;
    height: 3;
    margin: 0 1;
}

ReplicateExpensesView .action-buttons Button:hover {
    background: $accent;
}
