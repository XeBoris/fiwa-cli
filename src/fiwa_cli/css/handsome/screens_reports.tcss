/* ============================================
   REPORTS SCREEN STYLING (Settings-style layout)
   File: css/handsome/screens_reports.tcss
   Component: ReportsScreen
   ============================================ */
ReportsScreen {
    layout: vertical;
}
ReportsScreen #reports-title {
    text-style: bold;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    text-align: center;
}
ReportsScreen #reports-body {
    layout: horizontal;
    height: 1fr;
}
/* Sidebar styling */
ReportsScreen #reports-sidebar {
    width: 27;
    background: $panel;
    border-right: solid $accent;
    padding: 1;
    scrollbar-size: 4 1;
}
ReportsScreen .menu-section {
    text-style: bold;
    padding: 0;
    margin: 0;
    color: $accent;
    height: auto;
}
ReportsScreen #reports-sidebar Button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid $accent;
}
ReportsScreen #reports-sidebar Button:hover {
    background: $accent;
    color: $text;
}
/* ===================================
   WeekMonthPicker in sidebar 
   Override sizing to be compact
   =================================== */
ReportsScreen #reports-date-picker {
    width: 100%;
    height: 10;
    margin: 1 0 0 0;
}

/* Reset button for WeekMonthPicker */
ReportsScreen #reset-period-button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid $accent;
    background: $surface;
}

ReportsScreen #reset-period-button:hover {
    background: $accent;
    color: $text;
}

/* Override container to be more compact */
ReportsScreen #reports-date-picker .week-month-picker-container {
    width: 100%;
    height: auto;
    max-height: 11;
    min-height: 9;
    padding: 0;
    margin: 0;
}
/* Compact the period select dropdown */
ReportsScreen #reports-date-picker #wm-period-select {
    width: 100%;
    height: 3;
    max-height: 3;
    min-height: 3;
    margin: 0;
}
/* Ensure grid displays properly with navigation buttons visible */
ReportsScreen #reports-date-picker #week-month-picker-grid {
    grid-size: 2 2;         /* 2 columns, 2 rows */
    grid-gutter: 1 1;       /* No gaps between cells */
    width: 100%;
    height: auto;
    min-height: 6;
    max-width: 20;
    align: center middle;
}
/* Compact navigation buttons (◀ ▶) - IMPORTANT for visibility */
ReportsScreen #reports-date-picker .wm-nav-button {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 3;
    content-align: center middle;
    text-align: center;
    border: none;
    background: $accent;
    color: $text;
    padding: 0;
    margin: 0;
}
/* Compact display labels (Year and Week/Month) */
ReportsScreen #reports-date-picker .wm-display {
    width: 100%;
    height: 3;
    min-height: 2;
    max-height: 4;
    align: center middle;
    content-align: center middle;
    text-align: center;
    background: $panel;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}
/* Constrain dropdown overlay to not overflow sidebar */
ReportsScreen #reports-date-picker #wm-period-select SelectOverlay {
    max-height: 4;
}
ReportsScreen #reports-date-picker #wm-period-select OptionList {
    max-height: 4;
    height: auto;
}
/* Content area styling */
ReportsScreen #reports-content-area {
    width: 1fr;
    height: auto;
    padding: 2;
}
ReportsScreen .reports-placeholder {
    text-align: left;
    padding: 2;
    color: $text-muted;
    text-style: italic;
}
/* Back button styling */
ReportsScreen #menu-back-button {
    margin-top: 1;
    width: 100%;
    background: $primary;
}
ReportsScreen #menu-back-button:hover {
    background: $primary-lighten-1;
}
