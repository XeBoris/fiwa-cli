# Include all CSS and TCSS files from src/fiwa_cli/css
recursive-include src/fiwa_cli/css *.css *.tcss

# Include database schema files from src/fiwa_cli/database
recursive-include src/fiwa_cli/database *.sql

# Include top-level main.tcss from src/fiwa_cli
include src/fiwa_cli/main.tcss

# Include README and LICENSE
include README.md
include LICENSE
